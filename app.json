{
  "expo": {
    "name": "Globist",
    "slug": "globist",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.globist.app"
    },
    "android": {
      "package": "com.globist.app"
    },
    "plugins": [
      "expo-font",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Globist needs access to your photos so you can post a travel reel.",
          "videoPermission": "Globist needs access to your videos so you can post a travel reel."
        }
      ],
      "expo-status-bar"
    ]
  }
}
