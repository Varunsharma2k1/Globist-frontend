{
  "expo": {
    "name": "TripTape",
    "slug": "triptape",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": [
      "triptape",
      "com.triptape.app"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.triptape.app"
    },
    "android": {
      "package": "com.triptape.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "backgroundColor": "#4A1F7A"
      }
    },
    "plugins": [
      "expo-font",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "TripTape needs access to your photos so you can post a travel reel.",
          "videoPermission": "TripTape needs access to your videos so you can post a travel reel."
        }
      ],
      "expo-status-bar",
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      "./plugins/withLargeHeap",
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      "expo-image"
    ],
    "icon": "./assets/images/icon.png",
    "web": {
      "favicon": "./assets/images/favicon.png"
    }
  }
}
