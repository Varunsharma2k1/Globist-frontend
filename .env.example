# Copy this file to .env.local and fill in values for your machine.
# Expo automatically loads .env / .env.local / .env.development / .env.production
# and inlines any EXPO_PUBLIC_* variable into process.env at build time.
# See src/config/env.js for how these are validated and consumed.

# Backend API base URL. Must include the /api suffix.
# For a physical device/simulator, use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.29.4:5001/api

# Request timeout in milliseconds (optional, defaults to 10000).
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# 'development' | 'production' (optional, inferred from __DEV__ if unset).
EXPO_PUBLIC_APP_ENV=development

# Fallback video URL used when a reel has no uploaded media (optional).
EXPO_PUBLIC_DEFAULT_DEMO_VIDEO=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4
