# Copy this file to .env.local (git-ignored) and adjust for your machine.
# Expo automatically loads .env / .env.local / .env.development / .env.production
# and inlines any EXPO_PUBLIC_* variable into the app at bundle time.
# After changing any value, restart Metro with a clean cache: npx expo start -c
# See src/config/env.js for how these are resolved and validated.
#
# NOTE: EXPO_PUBLIC_* values are embedded in the app bundle and are readable by
# anyone with the app. Never put secrets (API keys, tokens) here.

# --- API -------------------------------------------------------------------

# Explicit backend base URL (must include the /api path).
#  - Local development: leave UNSET. The app auto-detects your computer's LAN IP
#    from the Metro dev server, so it keeps working when your IP changes.
#  - Set it only to point at a remote/staging API, or to pin a specific URL.
#  - Staging/production builds: REQUIRED (the app refuses to start without it).
# EXPO_PUBLIC_API_URL=https://api.example.com/api

# Used only for local auto-detection (when EXPO_PUBLIC_API_URL is unset).
# Must match the backend's PORT in globist-backend/.env.
EXPO_PUBLIC_API_PORT=5001
EXPO_PUBLIC_API_PATH=/api

# Request timeout in milliseconds (optional, defaults to 10000).
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# --- App -------------------------------------------------------------------

# 'development' | 'production' (optional, inferred from __DEV__ if unset).
EXPO_PUBLIC_APP_ENV=development


# --- Google sign-in ----------------------------------------------------------

# The WEB OAuth client ID (Google Cloud -> Credentials). Same value as the
# server's GOOGLE_OAUTH_CLIENT_IDS. Needs a development build (not Expo Go).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
